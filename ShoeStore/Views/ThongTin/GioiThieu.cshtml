@{
    ViewData["Title"] = "Về chúng tôi - Giới thiệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* BREADCRUMB */
    .info-breadcrumb-wrapper {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .info-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 15px;
        margin-bottom: 25px;
        font-size: 13.5px;
    }

        .info-breadcrumb .bc-home {
            color: #4B5563;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }

            .info-breadcrumb .bc-home:hover {
                color: #3B82F6;
            }

        .info-breadcrumb .bc-separator {
            color: #3B82F6;
            font-weight: 600;
        }

        .info-breadcrumb .bc-current {
            color: #021156;
            font-weight: 800;
            letter-spacing: 0.3px;
        }

    /* CONTAINER */
    .info-page-container {
        max-width: 1100px;
        margin: 0 auto 70px auto;
        padding: 0 15px;
    }

    .info-content-card {
        background: #FFFFFF;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        padding: 35px 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    /* HEADER BANNER */
    .about-hero {
        text-align: center;
        padding-bottom: 30px;
        margin-bottom: 30px;
        border-bottom: 1.5px solid #F1F5F9;
    }

        .about-hero h1 {
            font-size: 26px;
            font-weight: 900;
            color: #021156;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }

        .about-hero p {
            font-size: 15px;
            color: #64748B;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

    /* STATS ROW */
    .about-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 35px;
    }

    .stat-box {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 20px 15px;
        text-align: center;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .stat-box:hover {
            transform: translateY(-3px);
            border-color: #3B82F6;
        }

    .stat-number {
        font-size: 24px;
        font-weight: 900;
        color: #F59E0B;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 12.5px;
        color: #475569;
        font-weight: 600;
    }

    /* CONTENT SECTIONS */
    .about-section {
        margin-bottom: 30px;
    }

        .about-section h2 {
            font-size: 18px;
            font-weight: 800;
            color: #021156;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

            .about-section h2 .material-icons-outlined {
                color: #3B82F6;
                font-size: 22px;
            }

        .about-section p {
            font-size: 14px;
            line-height: 1.7;
            color: #334155;
            margin-bottom: 10px;
        }

    /* VALUES GRID */
    .values-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 18px;
    }

    .value-card {
        background: #FAFAFA;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 20px;
    }

    .value-icon {
        width: 44px;
        height: 44px;
        background: #EFF6FF;
        color: #2563EB;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .value-card h3 {
        font-size: 15px;
        font-weight: 800;
        color: #021156;
        margin-bottom: 6px;
    }

    .value-card p {
        font-size: 13px;
        color: #64748B;
        margin: 0;
        line-height: 1.5;
    }


</style>

<!-- Thanh Breadcrumb -->
<div class="info-breadcrumb-wrapper">
    <div class="info-breadcrumb">
        <a href="/TrangChu/TrangChu" class="bc-home">Trang chủ</a>
        <span class="bc-separator">/</span>
        <span class="bc-current">GIỚI THIỆU VỀ CHÚNG TÔI</span>
    </div>
</div>

<!-- Nội dung trang Giới thiệu -->
<div class="info-page-container">
    <div class="info-content-card">
        
        <!-- Header giới thiệu -->
        <div class="about-hero">
            <h1>CHÀO MỪNG ĐẾN VỚI MINHEE SPORTS</h1>
            <p>Minhee Sports là hệ thống phân phối giày thể thao, giày chạy bộ và sneaker chính hãng hàng đầu, mang đến cho bạn trải nghiệm vận động tự tin và bền bỉ trên mọi hành trình.</p>
        </div>

        <!-- Thống kê nổi bật -->
        <div class="about-stats-grid">
            <div class="stat-box">
                <div class="stat-number">100%</div>
                <div class="stat-label">Sản phẩm chính hãng</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">15.000+</div>
                <div class="stat-label">Khách hàng tin chọn</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">30 Ngày</div>
                <div class="stat-label">Đổi trả linh hoạt</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">24/7</div>
                <div class="stat-label">Hỗ trợ tư vấn tận tâm</div>
            </div>
        </div>

        <!-- Câu chuyện thương hiệu -->
        <div class="about-section">
            <h2>
                <span class="material-icons-outlined">flag</span>
                Câu chuyện thương hiệu
            </h2>
            <p>
                Được thành lập từ niềm đam mê thể thao và văn hóa đường phố bất tận, <strong>Minhee Sports</strong> khởi đầu với mong muốn giúp người yêu thể thao Việt Nam dễ dàng tiếp cận những mẫu giày chất lượng cao, thiết kế chuẩn phom dáng và êm ái nhất.
            </p>
            <p>
                Chúng tôi tin rằng một đôi giày tốt không chỉ bảo vệ đôi bàn chân của bạn trong từng sải bước mà còn là nguồn cảm hứng giúp bạn chinh phục những kỷ lục cá nhân mới mỗi ngày.
            </p>
        </div>

        <!-- Giá trị cốt lõi -->
        <div class="about-section">
            <h2>
                <span class="material-icons-outlined">verified</span>
                Giá trị cốt lõi của Minhee Sports
            </h2>
            <div class="values-grid">
                <div class="value-card">
                    <div class="value-icon">
                        <span class="material-icons-outlined">verified_user</span>
                    </div>
                    <h3>Chính hãng & Chuẩn chất lượng</h3>
                    <p>Mỗi sản phẩm tại cửa hàng đều trải qua quy trình kiểm định nguồn gốc và đường may nghiêm ngặt trước khi đến tay bạn.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">
                        <span class="material-icons-outlined">support_agent</span>
                    </div>
                    <h3>Tận tâm với khách hàng</h3>
                    <p>Đội ngũ tư vấn am hiểu sâu sắc về phom chân và từng bộ môn thể thao, giúp bạn chọn được đôi giày vừa vặn tuyệt đối.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">
                        <span class="material-icons-outlined">sync</span>
                    </div>
                    <h3>Chính sách rõ ràng</h3>
                    <p>Chính sách bảo hành, đổi size nhanh chóng và thanh toán linh hoạt giúp bạn hoàn toàn an tâm khi mua sắm online.</p>
                </div>
            </div>
        </div>

    </div>
</div>