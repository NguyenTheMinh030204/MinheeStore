@{
    ViewData["Title"] = "Hướng dẫn thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .info-breadcrumb-wrapper {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .info-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 15px;
        margin-bottom: 25px;
        font-size: 13.5px;
    }

        .info-breadcrumb .bc-home {
            color: #4B5563;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }

            .info-breadcrumb .bc-home:hover {
                color: #3B82F6;
            }

        .info-breadcrumb .bc-separator {
            color: #3B82F6;
            font-weight: 600;
        }

        .info-breadcrumb .bc-current {
            color: #021156;
            font-weight: 800;
            letter-spacing: 0.3px;
        }

    .info-page-container {
        max-width: 1100px;
        margin: 0 auto 70px auto;
        padding: 0 15px;
    }

    .info-content-card {
        background: #FFFFFF;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        padding: 35px 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .page-main-header {
        text-align: center;
        padding-bottom: 25px;
        margin-bottom: 30px;
        border-bottom: 1.5px solid #F1F5F9;
    }

        .page-main-header h1 {
            font-size: 24px;
            font-weight: 900;
            color: #021156;
            margin-bottom: 8px;
            line-height: 1.35;
        }

        .page-main-header p {
            font-size: 14px;
            color: #64748B;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

    .payment-guide-card {
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 25px;
        transition: border-color 0.2s ease;
    }

        .payment-guide-card:hover {
            border-color: #3B82F6;
        }

    .guide-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #E2E8F0;
    }

    .guide-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .guide-card-icon.cod-icon {
            background: #EFF6FF;
            color: #2563EB;
        }

        .guide-card-icon.bank-icon {
            background: #F0FDF4;
            color: #005F36;
        }

        .guide-card-icon .material-icons-outlined {
            font-size: 26px;
        }

        .guide-card-icon img {
            width: 32px;
            height: 32px;
            object-fit: contain;
        }

    .guide-card-title h3 {
        margin: 0 0 2px 0;
        font-size: 16px;
        font-weight: 800;
        color: #021156;
        line-height: 1.4;
    }

    .guide-card-title span {
        font-size: 12.5px;
        color: #64748B;
    }

    .guide-steps-list {
        margin: 0 0 14px 0;
        padding-left: 20px;
        font-size: 13.5px;
        color: #334155;
        line-height: 1.7;
    }

        .guide-steps-list li {
            margin-bottom: 8px;
        }

            .guide-steps-list li:last-child {
                margin-bottom: 0;
            }

    .bank-info-box {
        background: #FFFFFF;
        border: 1.5px dashed #005F36;
        border-radius: 10px;
        padding: 16px 20px;
        margin-top: 14px;
        font-size: 13.5px;
    }

    .bank-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #F1F5F9;
        gap: 12px;
    }

        .bank-info-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .bank-info-row .label {
            color: #64748B;
            flex-shrink: 0;
        }

        .bank-info-row .val {
            color: #021156;
            font-weight: 700;
            text-align: right;
            word-break: break-word;
        }

    .payment-alert-box {
        background: #FFFBEB;
        border: 1px dashed #F59E0B;
        border-radius: 12px;
        padding: 18px 20px;
        margin-top: 25px;
    }

        .payment-alert-box h4 {
            margin: 0 0 8px 0;
            font-size: 14.5px;
            font-weight: 800;
            color: #B45309;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .payment-alert-box h4 .material-icons-outlined {
                font-size: 20px;
                flex-shrink: 0;
            }

        .payment-alert-box ul {
            margin: 0;
            padding-left: 20px;
            font-size: 13px;
            color: #78350F;
            line-height: 1.6;
        }

        .payment-alert-box li {
            margin-bottom: 4px;
        }

            .payment-alert-box li:last-child {
                margin-bottom: 0;
            }

    @@media (max-width: 992px) {
        .info-content-card {
            padding: 28px 22px;
        }

        .payment-guide-card {
            padding: 20px;
        }
    }

    @@media (max-width: 768px) {
        .info-page-container {
            margin-bottom: 45px;
        }

        .info-content-card {
            padding: 22px 16px;
            border-radius: 12px;
        }

        .page-main-header {
            padding-bottom: 18px;
            margin-bottom: 22px;
        }

            .page-main-header h1 {
                font-size: 20px;
            }

            .page-main-header p {
                font-size: 13px;
            }

        .payment-guide-card {
            padding: 16px 14px;
            margin-bottom: 18px;
        }

        .guide-card-header {
            gap: 10px;
            padding-bottom: 10px;
            margin-bottom: 12px;
        }

        .guide-card-icon {
            width: 38px;
            height: 38px;
        }

        .guide-card-title h3 {
            font-size: 14.5px;
        }

        .guide-steps-list {
            padding-left: 18px;
            font-size: 13px;
        }

        .bank-info-box {
            padding: 12px 14px;
            font-size: 12.5px;
        }

        .bank-info-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
            padding: 6px 0;
        }

            .bank-info-row .val {
                text-align: left;
            }

        .payment-alert-box {
            padding: 15px;
        }

            .payment-alert-box ul {
                padding-left: 18px;
                font-size: 12.5px;
            }
    }

    @@media (max-width: 480px) {
        .info-breadcrumb {
            margin-top: 10px;
            margin-bottom: 16px;
            font-size: 12.5px;
        }

        .page-main-header h1 {
            font-size: 18px;
        }

        .guide-card-title h3 {
            font-size: 14px;
        }

        .payment-alert-box h4 {
            font-size: 13.5px;
        }
    }
</style>

<div class="info-breadcrumb-wrapper">
    <div class="info-breadcrumb">
        <a href="/TrangChu/TrangChu" class="bc-home">Trang chủ</a>
        <span class="bc-separator">/</span>
        <span class="bc-current">HƯỚNG DẪN THANH TOÁN</span>
    </div>
</div>

<div class="info-page-container">
    <div class="info-content-card">

        <div class="page-main-header">
            <h1>HƯỚNG DẪN THANH TOÁN TẠI MINHEE SPORTS</h1>
            <p>Minhee Sports hỗ trợ 2 phương thức thanh toán an toàn, linh hoạt và tiện lợi nhất cho khách hàng khi đặt mua sản phẩm online.</p>
        </div>

        <div class="payment-guide-card">
            <div class="guide-card-header">
                <div class="guide-card-icon cod-icon">
                    <span class="material-icons-outlined">local_shipping</span>
                </div>
                <div class="guide-card-title">
                    <h3>1. Thanh toán khi nhận hàng (COD - Cash On Delivery)</h3>
                    <span>Nhận hàng, kiểm tra sản phẩm trước khi thanh toán tiền mặt</span>
                </div>
            </div>

            <ol class="guide-steps-list">
                <li><strong>Bước 1:</strong> Tại bước Thanh toán đơn hàng, bạn chọn phương thức <strong>"Thanh toán khi nhận hàng (COD)"</strong> và nhấn <em>Xác nhận đặt hàng</em>.</li>
                <li><strong>Bước 2:</strong> Hệ thống ghi nhận đơn hàng và nhân viên Minhee Sports sẽ đóng gói, bàn giao cho đơn vị vận chuyển (GHTK / GHN / Viettel Post).</li>
                <li><strong>Bước 3:</strong> Khi nhân viên giao hàng (Shipper) mang giày tới, bạn được quyền mở hộp kiểm tra đúng mẫu, đúng size trước khi gửi tiền mặt cho shipper.</li>
            </ol>
        </div>

        <div class="payment-guide-card">
            <div class="guide-card-header">
                <div class="guide-card-icon bank-icon">
                    <span class="material-icons-outlined">account_balance</span>
                </div>
                <div class="guide-card-title">
                    <h3>2. Chuyển khoản Ngân hàng qua Vietcombank (Mã VietQR)</h3>
                    <span>Thanh toán tự động 24/7 qua Napas247 từ bất kỳ App Ngân Hàng nào</span>
                </div>
            </div>

            <ol class="guide-steps-list">
                <li><strong>Bước 1:</strong> Chọn phương thức <strong>"Chuyển khoản Ngân hàng (Vietcombank)"</strong> tại trang thanh toán.</li>
                <li><strong>Bước 2:</strong> Màn hình sẽ chuyển hướng tới Cổng thanh toán hiển thị mã <strong>VietQR</strong> động đã điền sẵn số tiền và nội dung đơn hàng.</li>
                <li><strong>Bước 3:</strong> Mở App ngân hàng trên điện thoại (VCB Digibank, MB Bank, Techcombank, VPBank,...) và thực hiện <strong>Quét mã QR</strong> để hoàn tất giao dịch.</li>
                <li><strong>Bước 4:</strong> Bấm nút <strong>"TÔI ĐÃ HOÀN TẤT CHUYỂN TIỀN"</strong> để hệ thống cập nhật trạng thái đơn hàng.</li>
            </ol>

            <div class="bank-info-box">
                <div class="bank-info-row">
                    <span class="label">Ngân hàng thụ hưởng:</span>
                    <span class="val">Vietcombank (VCB - Chi nhánh Hà Nội)</span>
                </div>
                <div class="bank-info-row">
                    <span class="label">Số tài khoản:</span>
                    <span class="val" style="color: #005F36; font-size: 15px;">9358187791</span>
                </div>
                <div class="bank-info-row">
                    <span class="label">Chủ tài khoản:</span>
                    <span class="val">NGUYEN THE MINH</span>
                </div>
                <div class="bank-info-row">
                    <span class="label">Cú pháp nội dung:</span>
                    <span class="val" style="color: #EF4444;">Thanh toan don [Mã đơn hàng]</span>
                </div>
            </div>
        </div>

        <div class="payment-alert-box">
            <h4>
                <span class="material-icons-outlined">security</span>
                Lưu ý an toàn thanh toán:
            </h4>
            <ul>
                <li>Minhee Sports chỉ sử dụng duy nhất một số tài khoản ngân hàng chính thức <strong>9358187791 tại Vietcombank</strong> mang tên <strong>NGUYEN THE MINH</strong>.</li>
                <li>Khách hàng vui lòng ghi đúng mã đơn hàng trong nội dung chuyển khoản để hệ thống xác nhận tự động nhanh nhất.</li>
                <li>Đơn hàng chuyển khoản sau khi hoàn tất sẽ được ưu tiên xuất kho trong vòng 2 - 4 giờ làm việc.</li>
            </ul>
        </div>

    </div>
</div>