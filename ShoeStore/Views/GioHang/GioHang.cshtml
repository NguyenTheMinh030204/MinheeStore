@model ShoeStore.Models.GioHang

@{
    ViewData["Title"] = "Giỏ hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var danhSachChiTiet = Model?.ChiTietGioHang?.ToList() ?? new List<ShoeStore.Models.ChiTietGioHang>();
    decimal tongTien = danhSachChiTiet.Sum(c => c.SoLuong * (c.BienTheGiay?.Giay?.GiaBan ?? 0));
    int tongSoLuong = danhSachChiTiet.Sum(c => c.SoLuong);
}

@section Styles {
    <link rel="stylesheet" href="~/css/GioHang.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TrangChu.css" asp-append-version="true" />
}

<!-- Hero Banner Section -->
<section class="hero-banner">
    <div class="banner-slider">
        <div class="slide active">
            <img src="/images/banner/banner1.png" alt="Sandal Cho Bé" class="banner-img">
        </div>
        <div class="slide">
            <img src="/images/banner/banner2.png" alt="Bộ Sưu Tập Mới" class="banner-img">
        </div>
    </div>
    <div class="banner-dots">
        <span class="dot active" data-index="0"></span>
        <span class="dot" data-index="1"></span>
    </div>
</section>

<!-- Breadcrumb -->
<div class="cart-breadcrumb-wrapper">
    <div class="cart-breadcrumb">
        <a href="/TrangChu/TrangChu" class="bc-home">Trang chủ</a>
        <span class="bc-separator">/</span>
        <span class="bc-current">GIỎ HÀNG CỦA TÔI</span>
    </div>
</div>

<div class="cart-container-custom">
    <!-- Giao diện khi giỏ hàng trống (render từ server hoặc hiển thị qua JS khi xóa hết) -->
    <div class="cart-empty-state" id="cartEmptyState" style="@(danhSachChiTiet.Count == 0 ? "display: flex;" : "display: none;")">
        <div class="cart-empty-icon">
            <span class="material-icons-outlined">remove_shopping_cart</span>
        </div>
        <h3>Giỏ hàng của bạn đang trống!</h3>
        <p>Hãy lựa chọn những đôi giày ưng ý nhất để tiếp tục mua sắm nhé.</p>
        <a href="/TrangChu/TrangChu" class="btn-continue-shopping">
            <span class="material-icons-outlined">arrow_back</span>
            TIẾP TỤC MUA SẮM
        </a>
    </div>

    @if (danhSachChiTiet.Count > 0)
    {
        <div id="cartMainContent">
            <!-- Danh sách từng Card sản phẩm -->
            <div class="cart-cards-list" id="cartCardsList">
                @foreach (var item in danhSachChiTiet)
                {
                    var giay = item.BienTheGiay?.Giay;
                    var giaBan = giay?.GiaBan ?? 0;
                    var thanhTien = giaBan * item.SoLuong;
                    var tonKho = item.BienTheGiay?.SoLuongTon ?? 0;

                    <div class="cart-card-item" id="cart-item-@item.MaChiTietGioHang" data-id="@item.MaChiTietGioHang">
                        <!-- Checkbox chọn món -->
                        <div class="card-checkbox-wrap">
                            <input type="checkbox" class="cart-checkbox" checked onchange="tinhTongTienTamTinh()" />
                        </div>

                        <!-- Ảnh sản phẩm -->
                        <div class="card-thumb-wrap">
                            <img src="@giay?.AnhChinh" alt="@giay?.TenGiay" class="card-thumb-img" />
                        </div>

                        <!-- Nội dung chi tiết -->
                        <div class="card-info-wrap">
                            <div class="card-info-top">
                                <a href="/Giay/ChiTiet?id=@giay?.MaGiay" class="card-product-name">@giay?.TenGiay</a>
                                <button type="button" class="btn-trash-delete" onclick="xoaSanPham(@item.MaChiTietGioHang)" title="Xóa sản phẩm">
                                    <span class="material-icons-outlined">delete_outline</span>
                                </button>
                            </div>

                            <!-- Size và Đơn giá -->
                            <div class="card-meta-line">
                                <span class="meta-size">Size: @item.BienTheGiay?.KichCo</span>
                                <span class="meta-unit-price">@giaBan.ToString("N0") VNĐ</span>
                            </div>

                            <!-- Bộ nút tăng giảm số lượng -->
                            <div class="card-qty-control">
                                <button type="button" class="btn-qty-action" onclick="thayDoiSoLuong(@item.MaChiTietGioHang, -1, @tonKho)">-</button>
                                <input type="text" id="qty-input-@item.MaChiTietGioHang" class="input-qty-value" value="@item.SoLuong" readonly />
                                <button type="button" class="btn-qty-action" onclick="thayDoiSoLuong(@item.MaChiTietGioHang, 1, @tonKho)">+</button>
                            </div>

                            <!-- Thành tiền dòng -->
                            <div class="card-item-total-price" id="row-total-@item.MaChiTietGioHang" data-price="@giaBan">
                                @thanhTien.ToString("N0") VNĐ
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Đường kẻ phân cách -->
            <div class="cart-section-divider"></div>

            <!-- Box tóm tắt và Thanh toán ở đáy -->
            <div class="cart-bottom-summary">
                <div class="summary-info-line">
                    <span class="summary-label">Số lượng mặt hàng:</span>
                    <strong class="summary-count" id="summaryTotalCount">@tongSoLuong</strong>
                </div>
                <div class="summary-info-line">
                    <span class="summary-label">Tổng tiền tạm tính:</span>
                    <strong class="summary-total-price" id="summaryGrandTotal">@tongTien.ToString("N0") VNĐ</strong>
                </div>
                <button type="button" class="btn-submit-checkout" onclick="tienHanhThanhToan()">
                    THANH TOÁN NGAY
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/GioHang.js" asp-append-version="true"></script>
    <script src="~/js/TrangChu.js" asp-append-version="true"></script>
}