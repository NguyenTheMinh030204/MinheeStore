<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Minhee Sports</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo.png" asp-append-version="true" />

    <!-- Google Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
    <!-- File CSS dùng chung -->
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true">
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Header Section -->
    <header class="header">
        <div class="header-top container">
            <!-- Nút 3 gạch Hamburger cho Mobile -->
            <button type="button" class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Toggle Menu">
                <span class="material-icons-outlined">menu</span>
            </button>

            <!-- Logo -->
            <div class="logo">
                <a href="/TrangChu/TrangChu">
                    <img src="/images/logo.png" alt="ShoeStore Logo" class="logo-img">
                </a>
            </div>

            <!-- Cụm Tìm Kiếm Live Search -->
            <div class="search-box-wrapper">
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm sản phẩm..." autocomplete="off">
                    <button type="button" id="searchBtn">
                        <span class="material-icons-outlined">search</span>
                    </button>
                </div>

                <!-- Popup Gợi Ý Tìm Kiếm -->
                <div id="searchResultsPopup" class="search-results-popup" style="display: none;">
                    <div class="search-popup-header">KẾT QUẢ TÌM KIẾM</div>
                    <div class="search-popup-sub-header">
                        <span class="sub-label">SẢN PHẨM</span>
                        <a href="#" id="viewAllSearchLink" class="view-all-link">Xem tất cả <span id="totalSearchCount">0</span> sản phẩm</a>
                    </div>
                    <div id="searchItemsList" class="search-items-list"></div>
                </div>
            </div>

            <!-- Actions Header -->
            <div class="header-actions">
                <div class="user-dropdown">
                    <a href="#" class="action-item user-btn">
                        <span class="material-icons-outlined">account_circle</span>
                        <span>@(User.Identity?.IsAuthenticated == true ? (User.Identity.Name ?? "Tài khoản") : "Tài khoản")</span>
                        <span class="material-icons-outlined arrow-icon">arrow_drop_down</span>
                    </a>
                    
                    <div class="dropdown-menu">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Đã đăng nhập -->
                            <a href="/TaiKhoan/ThongTinCaNhan" class="dropdown-item">
                                <span class="material-icons-outlined">person</span> Thông tin cá nhân
                            </a>
                            <a href="/DonHang/DonHangCuaToi" class="dropdown-item">
                                <span class="material-icons-outlined">shopping_bag</span> Đơn hàng của tôi
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="/TaiKhoan/DangXuat" class="dropdown-item logout-item">
                                <span class="material-icons-outlined">logout</span> Đăng xuất
                            </a>
                        }
                        else
                        {
                            <!-- Chưa đăng nhập -->
                            <a href="/TaiKhoan/DangNhap" class="dropdown-item">
                                <span class="material-icons-outlined">login</span> Đăng nhập
                            </a>
                            <a href="/TaiKhoan/DangKy" class="dropdown-item">
                                <span class="material-icons-outlined">person_add</span> Đăng ký tài khoản
                            </a>
                        }
                    </div>
                </div>

                <a href="/GioHang" class="action-item cart-btn">
                    <span class="material-icons-outlined">shopping_cart</span>
                    <span>Giỏ hàng</span>
                    <span class="cart-badge">0</span>
                </a>
            </div>
        </div>

        <!-- Main Navigation Menu -->
        <nav class="main-nav" id="mainNav">
            <div class="container nav-list">
                <a href="/TrangChu/TrangChu" class="nav-item">Trang chủ</a>
                <a href="/DanhMuc/DanhSach?id=HotSale" class="nav-item highlight">
                    <span class="material-icons-outlined">local_fire_department</span> HOT SALE
                </a>
                <a href="/DanhMuc/DanhSach?id=BeTrai" class="nav-item">Giày bé trai</a>
                <a href="/DanhMuc/DanhSach?id=BeGai" class="nav-item">Giày bé gái</a>
                <a href="/DanhMuc/DanhSach?id=BongRo" class="nav-item">Giày bóng rổ</a>
                <a href="/DanhMuc/DanhSach?id=Sandal" class="nav-item">Sandal cho bé</a>
            </div>
        </nav>
    </header>

    <!-- Nội dung thay đổi của từng View -->
    <main class="main-content container">
        @RenderBody()
    </main>

    <!-- Footer Section -->
    <footer class="footer">
        <div class="container footer-grid">
            <div class="footer-col">
                <h4>GIỚI THIỆU</h4>
                <p>CÔNG TY TNHH MINHEE SPORTS VIỆT NAM</p>
                <p><span class="material-icons-outlined">place</span> Địa chỉ: số nhà 6 Ngõ 197 Trần Phú, Văn Quán, quận Hà Đông, Thành phố Hà Nội</p>
                <p><span class="material-icons-outlined">phone</span> 0358187791</p>
                <p><span class="material-icons-outlined">email</span> nguyentheminh03022004@gmail.com</p>
            </div>
        
            <div class="footer-col">
                <h4>CHÍNH SÁCH</h4>
                <ul>
                    <li><a href="/chinh-sach-doi-tra">Chính sách đổi trả hàng/bảo hành</a></li>
                    <li><a href="/huong-dan-thanh-toan">Hướng dẫn thanh toán</a></li>
                    <li><a href="/chinh-sach-bao-mat">Chính sách bảo mật</a></li>
                    <li><a href="/chinh-sach-van-chuyen">Chính sách vận chuyển</a></li>
                    <li><a href="/chinh-sach-kiem-hang">Chính sách kiểm hàng</a></li>
                </ul>
            </div>
        
            <div class="footer-col">
                <h4>HỖ TRỢ KHÁCH HÀNG</h4>
                <ul>
                    <li><a href="/gioi-thieu">Giới thiệu</a></li>
                    <li><a href="/chinh-sach-dich-vu">Chính sách dịch vụ</a></li>
                </ul>
            </div>
        
            <div class="footer-col">
                <h4>LIÊN HỆ</h4>
                <div class="social-links">
                    <a href="https://www.facebook.com/minh.nonglanh" target="_blank" class="social-icon-btn"><img src="/images/2023_Facebook_icon.svg.webp" alt="Facebook" class="social-img"></a>
                    <a href="https://www.instagram.com/helloiamminh/" target="_blank" class="social-icon-btn"><img src="/images/Instagram_icon.png" alt="Instagram" class="social-img"></a>
                    <a href="https://x.com/TheMinh03022004" target="_blank" class="social-icon-btn"><img src="/images/images.png" alt="Twitter" class="social-img"></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- POPUP QUICK ADD TO CART & MUA NGAY DÙNG CHUNG -->
    <div id="quickAddToCartModal" class="quick-cart-modal-overlay" onclick="closeQuickCartModal()" style="display: none;">
        <div class="quick-cart-modal-box" onclick="event.stopPropagation();">
            <div class="quick-cart-header">
                <div class="quick-cart-title-wrap">
                    <span class="material-icons-outlined header-icon">tune</span>
                    <h5>TÙY CHỌN SẢN PHẨM</h5>
                </div>
                <button type="button" class="quick-cart-close" onclick="closeQuickCartModal()">&times;</button>
            </div>

            <div class="quick-cart-body">
                <div class="quick-cart-product-summary">
                    <div class="quick-cart-img-wrap">
                        <img id="quickCartImg" src="" alt="Ảnh sản phẩm">
                    </div>
                    <div class="quick-cart-meta">
                        <h4 id="quickCartTitle">Tên giày thể thao</h4>
                        <div id="quickCartPrice" class="quick-cart-price">0 VNĐ</div>
                    </div>
                </div>

                <div class="quick-cart-section">
                    <div class="section-label-row">
                        <label class="quick-cart-label">Chọn Size (33 - 41):</label>
                        <a href="javascript:void(0)" class="size-guide-link" onclick="openSizeModal()">
                            <span class="material-icons-outlined">straighten</span> Hướng dẫn chọn size
                        </a>
                    </div>
                    <div id="quickCartSizes" class="quick-cart-size-grid"></div>
                </div>

                <div class="quick-cart-section">
                    <label class="quick-cart-label">Số lượng:</label>
                    <div class="quick-cart-qty-wrapper">
                        <button type="button" class="btn-qty-modal" onclick="updateQuickQty(-1)">
                            <span class="material-icons-outlined">remove</span>
                        </button>
                        <input type="text" id="quickCartQuantity" value="1" readonly>
                        <button type="button" class="btn-qty-modal" onclick="updateQuickQty(1)">
                            <span class="material-icons-outlined">add</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="quick-cart-footer">
                <button type="button" class="btn-quick-add" onclick="confirmAddToCart()">
                    <span class="material-icons-outlined">add_shopping_cart</span>
                    <span>Thêm vào giỏ</span>
                </button>
                <button type="button" class="btn-quick-buy" onclick="confirmBuyNow()">
                    <span class="material-icons-outlined">bolt</span>
                    <span>MUA NGAY</span>
                </button>
            </div>
        </div>
    </div>

    <!-- POPUP MODAL HƯỚNG DẪN CHỌN SIZE GIÀY -->
    <div id="sizeGuideModal" class="size-guide-modal-overlay" onclick="closeSizeModal()" style="display: none;">
        <div class="size-guide-modal-box" onclick="event.stopPropagation();">
            <div class="size-guide-modal-header">
                <h5>
                    <span class="material-icons-outlined">straighten</span> BẢNG HƯỚNG DẪN CHỌN SIZE GIÀY
                </h5>
                <span class="btn-close-modal" onclick="closeSizeModal()">&times;</span>
            </div>
            <div class="size-guide-modal-body">
                <img src="/images/size.jpg" alt="Bảng hướng dẫn chọn size giày Minhee Sports">
            </div>
        </div>
    </div>

    <!-- File JS dùng chung -->
    <script src="~/js/_Layout.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>